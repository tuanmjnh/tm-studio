# TM Studio environment example
# Copy to .env and fill values. tm-hub seed keeps NUXT_PUBLIC_HUB_APP_ID and
# AUTH_JWT_SECRET in sync (see tm-hub/scripts/seed/shared.ts).

# TM Hub control plane
NUXT_PUBLIC_HUB_URL=http://localhost:4000
NUXT_PUBLIC_HUB_APP_ID=
AUTH_PROVIDER=hub
# Shared secret that verifies hub-issued JWTs (must match tm-hub AUTH_JWT_SECRET)
AUTH_JWT_SECRET=

# Server-to-server hub AI relay secret (issued per-app by tm-hub)
NUXT_HUB_APP_SECRET=

# Local AI vault defaults (Electron config.env slots)
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# FFmpeg (Electron packaged binaries; leave empty to use bundled resources)
FFMPEG_PATH=
FFPROBE_PATH=
