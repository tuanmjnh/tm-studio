# TM Studio environment example
# Copy to .env and fill values. Only PUBLIC configuration belongs here: this
# file is read at build time by Vite/Nuxt, and anything sensitive would be
# baked into the bundle (see docs/architecture/electron-build-security.md).

# TM Hub control plane (public identifiers, safe in the bundle)
NUXT_PUBLIC_HUB_URL=http://localhost:4000
NUXT_PUBLIC_HUB_APP_ID=
AUTH_PROVIDER=hub

# --- Server-only credentials -------------------------------------------------
# None of these are build inputs. Leave them empty in a packaged desktop app:
# per-install values live in userData/config.env, encrypted with safeStorage.
#   AUTH_JWT_SECRET        legacy HS256 secret, read at runtime during migration
#   AUTH_JWT_PUBLIC_KEYS   JSON array of hub PUBLIC JWKs (RS256); not a secret
#   AUTH_JWT_JWKS_URL      hub JWKS endpoint once the hub publishes one
#   AUTH_JWT_INTROSPECT_URL overrides the derived /api/v1/auth/introspect
#   NUXT_HUB_APP_SECRET    hub relay app secret, read per request at runtime
AUTH_JWT_SECRET=
AUTH_JWT_PUBLIC_KEYS=
AUTH_JWT_JWKS_URL=
NUXT_HUB_APP_SECRET=

# Local AI vault defaults (Electron config.env slots, encrypted at rest)
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
