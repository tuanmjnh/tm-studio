{
  "name": "tm-studio",
  "version": "0.1.0",
  "description": "TMCut standalone video studio - satellite app of TM Hub",
  "author": "Developer",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 4003",
    "preview": "nuxt preview --port 4003",
    "postinstall": "nuxt prepare",
    "nuxt-update": "pnpm update nuxt @nuxt/ui --latest",
    "pnpm-update": "pnpm self-update",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "dev:electron": "concurrently -k \"nuxt dev --port 4003\" \"wait-on http://localhost:4003 && node electron/tools/dev-electron-launcher.cjs\""
  },
  "dependencies": {
    "@he-tree/vue": "2.10.1",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.2",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/table-core": "^8.21.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.0",
    "jose": "^6.2.4",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "reka-ui": "2.11.0",
    "scule": "^1.3.0",
    "sortablejs": "^1.15.2",
    "striptags": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "tm-hub-client": "1.0.8",
    "to-px": "^1.1.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.44",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/sortablejs": "^1.15.8",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.4",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.13",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@12.15.0"
