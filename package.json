{
  "name": "tm-studio",
  "version": "0.1.0",
  "description": "TMCut standalone video studio - satellite app of TM Hub",
  "author": "Developer",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 4003",
    "preview": "nuxt preview --port 4003",
    "postinstall": "nuxt prepare",
    "nuxt-update": "pnpm update nuxt @nuxt/ui --latest",
    "pnpm-update": "pnpm self-update",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "dev:electron": "concurrently -k \"nuxt dev --port 4003\" \"wait-on http://localhost:4003 && node electron/tools/dev-electron-launcher.cjs\"",
    "build:core": "pnpm --dir packages/core build",
    "test:core": "node --test \"packages/core/test/*.test.mjs\"",
    "check:core": "node packages/core/tools/check-boundaries.mjs",
    "lint:core": "eslint packages/core/src",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.check.json",
    "test:tmcut": "tsx tests/unit/run-all.mts",
    "test:render": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_render_graph.spec.ts",
    "test:time": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_time_domain.spec.ts",
    "test:store": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_store_behaviour.spec.ts",
    "test:templates": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_templates.spec.ts",
    "test:history": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_history.spec.ts",
    "test:agent": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_agent_tools.spec.ts",
    "test:voice": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_voice_commands.spec.ts",
    "test:video-templates": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_video_templates.spec.ts",
    "test:recordings": "node --test electron/tools/recordings.test.mjs",
    "test:media-download": "node --test electron/tools/media-download.test.mjs",
    "test:save": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_save_lifecycle.spec.ts",
    "test:ripple": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_ripple.spec.ts",
    "test:markers": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_markers.spec.ts",
    "test:transitions": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_transitions.spec.ts",
    "test:split-trim": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_split_trim.spec.ts",
    "test:groups": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_groups.spec.ts",
    "test:projects": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_projects_lifecycle.spec.ts",
    "test:tracks": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_tracks.spec.ts",
    "test:copy-paste": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_copy_paste.spec.ts",
    "test:recovery": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_recovery.spec.ts",
    "test:dashboard": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_dashboard.spec.ts",
    "test:ripple2": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_ripple2.spec.ts",
    "test:importpath": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_import_path.spec.ts",
    "test:fxlib": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_fx_library.spec.ts",
    "test:fxpreview": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_fx_preview.spec.ts",
    "test:ai-script": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_ai_script.spec.ts",
    "test:autocut": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_autocut_v2.spec.ts",
    "test:smoke": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_render_smoke.spec.ts",
    "test:html-video-smoke": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_html_video_smoke.spec.ts",
    "test:ai": "node --test electron/tools/ai-gateway.test.mjs",
    "test:factory": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_video_factory.spec.ts",
    "test:assembly": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_video_assembly.spec.ts",
    "test:sources": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_output_sources.spec.ts",
    "test:runway": "node --test electron/tools/video-generation/runway-adapter.test.mjs",
    "test:process": "tsx --tsconfig tsconfig.test.json tests/unit/tmcut_process.spec.ts"
  },
  "dependencies": {
    "@he-tree/vue": "2.10.1",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.2",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/table-core": "^8.21.3",
    "@tmcut/core": "file:packages/core",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.17.0",
    "jose": "^6.2.4",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "reka-ui": "2.11.0",
    "scule": "^1.3.0",
    "sortablejs": "^1.15.2",
    "striptags": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "tm-hub-client": "1.0.8",
    "to-px": "^1.1.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.44",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/eslint": "^1.16.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/sortablejs": "^1.15.8",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.4",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.13",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
