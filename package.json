{
  "name": "tm-studio",
  "version": "0.1.0",
  "description": "TMCut standalone video studio - satellite app of TM Hub",
  "author": "Developer",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 4003",
    "preview": "nuxt preview --port 4003",
    "postinstall": "nuxt prepare",
    "nuxt-update": "pnpm update nuxt @nuxt/ui --latest",
    "pnpm-update": "pnpm self-update",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "dev:electron": "concurrently -k \"nuxt dev --port 4003\" \"wait-on http://localhost:4003 && node electron/tools/dev-electron-launcher.cjs\"",
    "build:core": "pnpm --dir packages/core build",
    "test:core": "node --test \"packages/core/test/*.test.mjs\"",
    "check:core": "node packages/core/tools/check-boundaries.mjs",
    "lint:core": "eslint packages/core/src",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.check.json",
    "test": "tsx tests/unit/run-all.mts && node --test \"electron/tools/*.test.mjs\"",
    "test:unit": "tsx tests/unit/run-all.mts",
    "test:electron": "node --test \"electron/tools/*.test.mjs\"",
    "test:tmcut": "tsx tests/unit/run-all.mts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.17.0",
    "jose": "^6.2.4",
    "mediabunny": "1.65.1",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.2",
    "striptags": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "tm-hub-client": "1.1.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.44",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.8",
    "concurrently": "^10.0.4",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.13",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}